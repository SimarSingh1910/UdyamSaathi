# Copy to .env.local and fill in. Never commit real keys.

# LLM for the advisor: gemini | groq | openai | anthropic. Leave the key empty to run on rules only.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional model override (defaults: gemini-2.5-flash, llama-3.3-70b-versatile, gpt-4o-mini, claude-haiku-4-5)
LLM_MODEL=
