# Copy to .env.local and fill in. Never commit real keys.

# LLM for the advisor: gemini | groq | openai | anthropic. Leave the key empty to run on rules only.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional model override (defaults: gemini-2.5-flash, openai/gpt-oss-120b, gpt-4o-mini, claude-haiku-4-5)
LLM_MODEL=

# Passcode for the Accel back office at /admin (defaults to accel-demo if unset)
ADMIN_PASSCODE=

# Generate with: openssl rand -hex 32
UDYAM_ENCRYPTION_KEY=

# PostgreSQL, e.g. postgres://user:password@host:5432/udyamsaathi (add ?sslmode=require for
# Neon, Supabase or Render). Leave empty to use an embedded PostgreSQL in .data/pglite.
DATABASE_URL=

# Public URL of this app, used for order-tracking links sent on WhatsApp
PUBLIC_BASE_URL=

# --- WhatsApp Business (Meta Cloud API) ---
# Leave empty to run in demo mode: try the bot at /whatsapp on localhost.
# From Meta for Developers > your app > WhatsApp > API setup:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings > Basic > App secret (used to check webhook signatures; required)
WHATSAPP_APP_SECRET=
# Any string you choose; enter the same one when registering the webhook URL
WHATSAPP_VERIFY_TOKEN=
# Approved "Authentication" template with a copy-code button, for phone codes
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# --- Missed-call verification (Exotel, Knowlarity, 2Factor, ...) ---
# The number owners ring. Point the provider's webhook at
# /api/verify/missed-call?secret=<MISSED_CALL_WEBHOOK_SECRET>
MISSED_CALL_NUMBER=
MISSED_CALL_WEBHOOK_SECRET=

# Phone checks without providers: codes shown on screen, missed calls simulated.
# On by default in development, off in production unless set to 1 (e.g. for a hosted demo).
PHONE_VERIFY_DEMO=
